rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helpers
    // ============================================================

    function isLoggedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'super_admin';
    }

    function isCompanyUser(companyId) {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().companyId == companyId;
    }

    // إضافة/تعديل مستندات الشركة — بدون super_admin لازم الـ companyId يطابق شركته
    function canCreateForCompany() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (isSuperAdmin() || request.resource.data.companyId == getUserData().companyId);
    }

    // قراءة/تعديل/حذف مستند — بدون super_admin لازم المستند يخص شركته
    function canAccessCompanyDoc() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (isSuperAdmin() || resource.data.companyId == getUserData().companyId);
    }

    // ============================================================
    // users/{userId}
    // ============================================================
    match /users/{userId} {
      allow get: if isLoggedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();

      // المستخدم يقدر يعمل مستنده بس
      allow create: if isLoggedIn() && request.auth.uid == userId &&
        (!("isSuperAdmin" in request.resource.data) ||
         request.resource.data.isSuperAdmin == false);

      // المستخدم يعدل نفسه فقط، وممنوع يغير الـ role
      // يُسمح بتغيير companyId فقط من null إلى قيمة (عند الانضمام بالكود)
      // (السوبر أدمن يقدر يعدل أي مستخدم)
      allow update: if isLoggedIn() &&
        (request.auth.uid == userId || isSuperAdmin()) &&
        (request.resource.data.role == resource.data.role) &&
        (
          // السوبر أدمن يقدر يغير أي حقل
          isSuperAdmin() ||
          // المستخدم العادي: companyId إما ثابت أو يتغير من null إلى قيمة (انضمام)
          (request.resource.data.companyId == resource.data.companyId) ||
          (resource.data.companyId == null && request.resource.data.companyId != null)
        );

      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // companies/{companyId}
    // ============================================================
    match /companies/{companyId} {
      // أي مستخدم مسجل يقدر يقرأ شركة (لأن كود الانضمام بيتشارك)
      allow get: if isLoggedIn();
      // أي مستخدم مسجل يقدر يبحث عن الشركات بالكود (list) للانضمام
      allow list: if isLoggedIn();
      allow create: if true;
      allow update: if isSuperAdmin() || isCompanyUser(companyId);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // invoices/{invoiceId} — عزل كامل حسب الشركة
    // ============================================================
    match /invoices/{invoiceId} {
      allow get: if canAccessCompanyDoc();
      allow list: if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    // ============================================================
    // inventory/{itemId} — عزل كامل حسب الشركة
    // ============================================================
    match /inventory/{itemId} {
      allow get: if canAccessCompanyDoc();
      allow list: if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    // ============================================================
    // tasks/{taskId} — عزل كامل حسب الشركة
    // ============================================================
    match /tasks/{taskId} {
      allow get: if canAccessCompanyDoc();
      allow list: if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    // ============================================================
    // projects/{projectId} — عزل كامل حسب الشركة
    // ============================================================
    match /projects/{projectId} {
      allow get: if canAccessCompanyDoc();
      allow list: if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    // ============================================================
    // suppliers/{supplierId} — عزل كامل حسب الشركة
    // ============================================================
    match /suppliers/{supplierId} {
      allow get: if canAccessCompanyDoc();
      allow list: if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    // ============================================================
    // clients/{clientId} — عزل كامل حسب الشركة
    // ============================================================
    match /clients/{clientId} {
      allow get: if canAccessCompanyDoc();
      allow list: if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    // ============================================================
    // sellers/{sellerId} — عزل كامل حسب الشركة
    // ============================================================
    match /sellers/{sellerId} {
      allow get: if canAccessCompanyDoc();
      allow list: if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    // ============================================================
    // buyers/{buyerId} — عزل كامل حسب الشركة
    // ============================================================
    match /buyers/{buyerId} {
      allow get: if canAccessCompanyDoc();
      allow list: if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    // ============================================================
    // messages/{messageId} — عزل كامل حسب الشركة
    // ============================================================
    match /messages/{messageId} {
      allow get: if canAccessCompanyDoc();
      allow list: if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    // ============================================================
    // patients/{patientId} — عزل كامل حسب الشركة
    // ============================================================
    match /patients/{patientId} {
      allow get: if canAccessCompanyDoc();
      allow list: if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    // ============================================================
    // appointments/{appointmentId} — عزل كامل حسب الشركة
    // ============================================================
    match /appointments/{appointmentId} {
      allow get: if canAccessCompanyDoc();
      allow list: if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    // ============================================================
    // prescriptions/{prescriptionId} — عزل كامل حسب الشركة
    // ============================================================
    match /prescriptions/{prescriptionId} {
      allow get: if canAccessCompanyDoc();
      allow list: if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

  }
}
