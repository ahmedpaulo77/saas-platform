  rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {

      // ============================================================
      // Helper functions — الأساسيات
      // ============================================================

      function isLoggedIn() {
        return request.auth != null;
      }

      function getUserData() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }

      function isSuperAdmin() {
        return isLoggedIn() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().role == 'super_admin';
      }

      function isAdmin() {
        return isLoggedIn() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (getUserData().role == 'admin' || getUserData().role == 'super_admin');
      }

      function userCompanyId() {
        return isLoggedIn() ? getUserData().companyId : null;
      }

      // ============================================================
      // ✅ فحوصات isActive — الإيقاف الحقيقي على مستوى القواعد
      // ============================================================

      function requestingUserIsActive() {
        return isLoggedIn() && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          getUserData().isActive != false
        );
      }

      // طلب الشركة: لازم يبقى نشط
      // (لو الشركة اتمسحت، الحاجز الحقيقي في userCompanyWasDeleted تحت —
      //  احنا هنا بنسمح لـ user لسه مالوش شركة إنه يعدّي)
      function requestingCompanyIsActive() {
        return isLoggedIn() && (
          isSuperAdmin() ||
          userCompanyId() == null ||
          !exists(/databases/$(database)/documents/companies/$(userCompanyId())) ||
          get(/databases/$(database)/documents/companies/$(userCompanyId())).data.isActive != false
        );
      }

      // ✅ الشركة اتمسحت فعلًا؟ مستخدم شركة مفقود لازم يبقى محجوب.
      //
      // 🔴 المشكلة: requestingCompanyIsActive فوق بتعتبر "الشركة مش موجودة"
      //    = نشطة (意図ها إن المستخدم اللي لسه مخلّيش شركة يقدر يسجّل).
      //    بس ده كان بيعني إن **Superdelete الشركة ما كانش بيعمل حاجة**:
      //    الـ users بيفضلوا معاهم companyId وfullyActive() بترجع true،
      //    فيفضلوا شغالين على بيانات يتيمة ومخفية عن السوبر أدمن.
      //    (userCompanyId() بترمي لو مفيش user doc — عشان كده الحاجز
      //     الصريح للـ exists هنا)
      function userCompanyWasDeleted() {
        return isLoggedIn() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().companyId != null &&
          !exists(/databases/$(database)/documents/companies/$(getUserData().companyId));
      }

      function fullyActive() {
        return requestingUserIsActive() && requestingCompanyIsActive() && !userCompanyWasDeleted();
      }

      // ============================================================
      // ✅ صلاحيات القراءة/الإنشاء/الحذف/التعديل على بيانات الشركة
      // ============================================================

      function canCreateForCompany() {
        return fullyActive() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (isSuperAdmin() ||
          (request.resource.data.companyId == userCompanyId() && userCompanyId() != null));
      }

      function canAccessCompanyDoc() {
        return fullyActive() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (isSuperAdmin() || resource.data.companyId == userCompanyId());
      }

      // 🔴 إصلاح ثغرة (4): منع تحويل المستند لشركة تانية أثناء التعديل
      function canUpdateCompanyDoc() {
        return fullyActive() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (isSuperAdmin() || resource.data.companyId == userCompanyId()) &&
          (!('companyId' in request.resource.data) ||
          request.resource.data.companyId == resource.data.companyId);
      }

      function canDeleteCompanyDoc() {
        return fullyActive() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          isAdmin() &&
          (isSuperAdmin() || resource.data.companyId == userCompanyId());
      }

      // 🔴 إصلاح: كولكشنز مالية حساسة — الموظف العادي ميعدّلش فواتير/مصروفات بعد إنشائها
      //    القراءة/الإنشاء لسه لأي حد في الشركة (عشان الموظف يقدر يعمل فاتورة)
      //    لكن التعديل (زي تغيير المبلغ أو حالة "مدفوعة") لـ isAdmin() بس
      function canUpdateFinancialDoc() {
        return fullyActive() &&
          isAdmin() &&
          (isSuperAdmin() || resource.data.companyId == userCompanyId()) &&
          (!('companyId' in request.resource.data) ||
          request.resource.data.companyId == resource.data.companyId);
      }

      // 🔴 إصلاح: حماية أسعار المخزون — الموظف يقدر يعدّل الكمية، بس السعر لـ isAdmin() بس
      function canUpdateInventoryDoc() {
        return canUpdateCompanyDoc() &&
          (
            isAdmin() ||
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['price', 'costPrice', 'sellingPrice', 'purchasePrice'])
          );
      }

      // ✅ المطبخ: أي فرد في الشركة يقدر يغيّر حالة الأوردر فقط (من غير المبالغ)
      function canUpdateOrderStatus() {
        return fullyActive() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (isSuperAdmin() || resource.data.companyId == userCompanyId()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderStatus']) &&
          request.resource.data.orderStatus in ['new', 'preparing', 'ready', 'completed', 'delivered', 'cancelled'];
      }

      // ============================================================
      // ✅ صلاحيات إدارة المستخدمين لأدمن الشركة
      // ============================================================

      function canManageTargetUser(targetUserData) {
        return fullyActive() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            isSuperAdmin() ||
            (
              isAdmin() &&
              targetUserData != null &&
              targetUserData.role != 'super_admin' &&
              targetUserData.companyId == userCompanyId() &&
              userCompanyId() != null
            )
          );
      }

      function canCreateTargetUser(newUserData) {
        return fullyActive() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            isSuperAdmin() ||
            (
              isAdmin() &&
              newUserData.role != 'super_admin' &&
              newUserData.companyId == userCompanyId() &&
              userCompanyId() != null
            )
          );
      }

      // ============================================================
      // users/{userId}
      // ============================================================
      match /users/{userId} {

        allow get: if
          (isLoggedIn() && request.auth.uid == userId) ||
          isSuperAdmin() ||
          (
            fullyActive() &&
            isAdmin() &&
            resource.data.role != 'super_admin' &&
            resource.data.companyId == userCompanyId() &&
            userCompanyId() != null
          );

        // 🔴 إصلاح: list مقفول على الأدمن.
        // السبب: أي قاعدة list ما بذكرش resource.data مش بتفرض أي شرط على الـ query،
        // فـ getDocs(collection(db,'users')) من حساب عادي كان بيرجّع يوزرات *كل*
        // الشركات (إيميل + role + companyId) + _joinCode بتاعهم، وكود الدعوة ده
        // كافي يعمل حساب داخل أي شركة (انظر فرع "ب" في create بالظبط).
        // ملاحظة: Messages.js بيقرا الـ users مفلتر بـ companyId، بس الكود
        // مش ضابط أمني — لو الكويري اتغيّر أو حد فتح الكونسول، التسريب بيرجع.
        allow list: if fullyActive() && (
          isSuperAdmin() ||
          (isAdmin() && userCompanyId() != null)
        );

        // 🔴 إصلاح ثغرة (1) + 🟡 allowlist للحقول: منع أي حقل غريب (زي permissions أو isSuperAdmin مخبأة)
        allow create: if
          request.resource.data.keys().hasOnly(['email', 'role', 'companyId', 'createdAt', 'isActive', '_joinCode']) &&
          (
            // أ) هو نفسه اللي أنشأ الشركة دي لتوه (مقارنة creatorUid على مستند الشركة)
            isLoggedIn() && request.auth.uid == userId &&
            request.resource.data.role == 'admin' &&
            request.resource.data.companyId != null &&
            exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId)) &&
            get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.creatorUid == request.auth.uid
          ) || (
            // ب) بينضم بكود دعوة حقيقي بيتحقق منه من invite_codes/{code}.
            //    companyId بييجي من الكود نفسه (مش من تخمين المستخدم) وبيتحقق
            //    إن الكود ده فعلاً متاع الشركة دي وإن دوره = الدور المطلوب.
            isLoggedIn() && request.auth.uid == userId &&
            request.resource.data.role != 'super_admin' &&
            '_joinCode' in request.resource.data &&
            exists(/databases/$(database)/documents/invite_codes/$(request.resource.data._joinCode)) &&
            get(/databases/$(database)/documents/invite_codes/$(request.resource.data._joinCode)).data.companyId == request.resource.data.companyId &&
            get(/databases/$(database)/documents/invite_codes/$(request.resource.data._joinCode)).data.role == request.resource.data.role
          ) || (
            // ج) مدير (سوبر/شركة) بيضيف مستخدم يدويًا
            canCreateTargetUser(request.resource.data)
          );

        // 🟡 allowlist: امنع أي حقل مش من القائمة دي يتغير أو يتضاف
        //    ⚠️ عدّل اللستة دي لو عندك حقول بروفايل تانية (زي name, phone, photoURL...)
        //
        //    deletedAt:Soft delete بتستخدمه صفحة المستخدمين. السبب إن
        //    حذف المستند بالكامل مش بيمسح حساب Firebase Auth، والأسوأ إن
        //    الـ uid اللي مالهوش doc بيعتبر "نشط" (شوف requestingUserIsActive)
        //    فكان الحساب المسروق هيفتح تاني لو حذفنا الدوك. فبنوقفه بدل ما
        //    نمسحه: isActive=false يمنع كل وصول فورًا + reset email.
        allow update: if fullyActive() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['role', 'companyId', 'isActive', 'email', '_joinCode', 'deletedAt']) &&
          (
          isSuperAdmin() ||
          (
            isAdmin() &&
            canManageTargetUser(resource.data) &&
            // 🔴 إصلاح: منع نقل المستخدم لشركة تانية.
            // canManageTargetUser بيتأكد إن companyId *القديم* = شركتي، بس من غير
            // السطر ده كان ينفع أعمل updateDoc(users/uid, {companyId: '<شركة B>'})
            // والحساب ده ياخد صلاحيات كاملة على شركة تانية.
            // نفس الحماية موجودة في canUpdateCompanyDoc — هنا كانت ناقصة.
            (!('companyId' in request.resource.data) ||
             request.resource.data.companyId == resource.data.companyId) &&
            request.resource.data.role != 'super_admin' &&
            request.auth.uid != userId
          ) ||
          (
            isLoggedIn() && request.auth.uid == userId &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.companyId == resource.data.companyId &&
            (
              !('isActive' in request.resource.data) ||
              request.resource.data.isActive == resource.data.isActive ||
              resource.data.isActive == null
            )
          ) ||
          (
            // 🆕 حالة Setup.js: مستخدم بلا شركة (companyId:null) بيكمل التسجيل
            // بإنشاء أول شركة ليه ويبقى أدمنها — نفس منطق فرع "أ" في create بالظبط
            isLoggedIn() && request.auth.uid == userId &&
            resource.data.companyId == null &&
            request.resource.data.role == 'admin' &&
            request.resource.data.companyId != null &&
            exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId)) &&
            get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.creatorUid == request.auth.uid
          )
        );

        allow delete: if fullyActive() && (
          (isSuperAdmin() && request.auth.uid != userId) ||
          (
            isAdmin() &&
            !isSuperAdmin() &&
            resource.data.role != 'super_admin' &&
            resource.data.companyId == userCompanyId() &&
            request.auth.uid != userId
          )
        );
      }

      // ============================================================
      // companies/{companyId}
      // ============================================================
      match /companies/{companyId} {
        // ✅ get: مفتوح لكل المسجلين — الأكواد بقت في كولكشن تاني، فمفيش حاجة حساسة هنا
        allow get: if isLoggedIn();

        // 🔴 إصلاح ثغرة (2): list مقفول تماماً — مفيش أي سبب برمجي لعمل list على الشركات
        allow list: if isSuperAdmin();

        // إنشاء شركة — لازم يثبت creatorUid لنفسه، وميكونش عنده شركة أصلاً
        // ✅ الستة دي بالظبط هي اللي Signup.js و Setup.js بيكتبوهم.
        //    لو ضفت حقول في فورم إنشاء الشركة، ضيفها هنا في نفس اللحظة.
        allow create: if requestingUserIsActive() &&
          (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          getUserData().companyId == null) &&
          request.resource.data.isActive == true &&
          request.resource.data.creatorUid == request.auth.uid &&
          request.resource.data.keys().hasOnly(['name', 'email', 'industry', 'createdAt', 'isActive', 'creatorUid']);

      // 🔴 إصلاح ثغرة (3): التعديل لـ isAdmin() بس، مع حماية isActive/plan/subscription
      allow update: if fullyActive() &&
        // ⚠️ الأكواد (adminInviteCode/userInviteCode) اتشالوا من هنا: المصدر
        //    الرسمي للتحقق هو invite_codes (كولكشن مسطح، list مقفولة)،
        //    ونسخة العرض في companies/{companyId}/codes/current (get بالـ id).
        //    لو لسه في بيانات قديمة بالحقلين دول، باقيين بس مش هيتقروا بالتعديل.
        //
        // ⚠️ updatedAt لازم تكون هنا: SuperAdminDashboard بيكتبها مع isActive
        //    (تفعيل/إيقاف الشركة). من غيرها الـ write بيرجع permission-denied
        //    والزرار بيعمل حاجة وبيبان إنه نجح. لو ضفت تاريخ جديد، ضيفه هنا.
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'industry', 'isActive', 'plan', 'subscription', 'logo', 'address', 'phone', 'updatedAt']) &&
          (
          isSuperAdmin() ||
          (
            isAdmin() &&
            userCompanyId() == companyId &&
            (!('isActive' in request.resource.data) || request.resource.data.isActive == resource.data.isActive) &&
            (!('plan' in request.resource.data) || request.resource.data.plan == resource.data.plan) &&
            (!('subscription' in request.resource.data) || request.resource.data.subscription == resource.data.subscription) &&
            (!('creatorUid' in request.resource.data) || request.resource.data.creatorUid == resource.data.creatorUid)
          )
        );

        allow delete: if isSuperAdmin();
      }

      // ============================================================
      // invite_codes/{code} — المصدر الرسمي للتحقق من كود الدعوة
      // ============================================================
      // ⚠️ ليش كولكشن مسطح مش سبل-كولكشن؟ لأن المستخدم بيكتب الكود وهو
      //    مش عارف رقم الشركة — يعني لازم نلاقي الشركة من الكود نفسه.
      //    فـ doc id = الكود هو الفهرس الوحيد الممكن.
      //    الأمان هنا مش في المسار، الأمان في:
      //      1) list مقفولة تماماً — مستحيل أحد يجيب كل أكواد كل الشركات
      //    2) get بالـ id بالظبط بس — والكود 10 حروف من 32 رمز
      //         (≈ 10^15 احتمال) بـ crypto.getRandomValues، مش قابل للتخمين
      //      3) التسريب الوحيد كان عبر users list (لأنه كان بيصدّر _joinCode)
      //         واتقفل — شوف allow list في match /users بالظبط
      match /invite_codes/{code} {
        allow get: if isLoggedIn();
        allow list: if false;

        // الإنشاء مسموح في 3 حالات:
        //  أ) السوبر أدمن (بينشئ شركة لعميل ويولّد أكوادها)
        //  ب) صاحب الشركة (لحظة إنشاء الشركة، قبل ما يبقى عنده companyId)
        //  ج) أدمن الشركة الحالي (تجديد / استبدال كود ضايع)
        allow create: if isLoggedIn() &&
          request.resource.data.companyId != null &&
          request.resource.data.keys().hasOnly(['companyId', 'role', 'createdAt']) &&
          request.resource.data.role in ['admin', 'user'] &&
          exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId)) &&
          (
            isSuperAdmin() ||
            get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.creatorUid == request.auth.uid ||
            (fullyActive() && isAdmin() && userCompanyId() == request.resource.data.companyId)
          );

        // 🔴 update ممنوع نهائياً: ما ينفعش كود يتنقل لشركة تانية أو يتغيّر دوره.
        //    "التجديد" = حذف القديم + إنشاء جديد (تحت).
        allow update: if false;

        // حذف (إبطال كود): أدمن نفس الشركة بس
        allow delete: if fullyActive() && isAdmin() &&
          resource.data.companyId == userCompanyId();
      }

      // ============================================================
      // companies/{companyId}/codes/current — نسخة العرض للأدمن
      // ============================================================
      // المصدر الحقيقي للتحقق هو invite_codes فوق. الدوك ده للعرض بس
      // (نسخ/لصق الكود من صفحة "شركتي") — و get بالـ id فمفيش list خالص.
      match /companies/{companyId}/codes/{docId} {
        allow get: if fullyActive() && isAdmin() && userCompanyId() == companyId;
        allow list: if false;
        allow create, update: if fullyActive() && isAdmin() && userCompanyId() == companyId &&
          request.resource.data.keys().hasOnly(['adminCode', 'userCode', 'updatedAt']);
        allow delete: if false;
      }

      // ============================================================
      // بيانات الشركة — عزل كامل حسب companyId
      // ============================================================

      match /clients/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateCompanyDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /sellers/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateCompanyDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /buyers/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateCompanyDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      // 🔴 مالية — التعديل بعد الإنشاء لـ isAdmin() بس (منع تلاعب موظف بفاتورة مدفوعة)
      // ✅ استثناء: تغيير orderStatus مسموح لأي فرد في الشركة (شاشة المطبخ)
      match /invoices/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateFinancialDoc() || canUpdateOrderStatus();
        allow delete: if canDeleteCompanyDoc();
      }

      match /quotations/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateFinancialDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /purchases/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateFinancialDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /expenses/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateFinancialDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      // 🔴 المخزون: أي موظف يقدر يعدّل الكمية، بس السعر لـ isAdmin() بس
      match /inventory/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateInventoryDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /tasks/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateCompanyDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /projects/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateCompanyDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /suppliers/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateCompanyDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /messages/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateCompanyDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /patients/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateCompanyDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /appointments/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateCompanyDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /prescriptions/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateCompanyDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /menu_categories/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateCompanyDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /variant_codes/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateCompanyDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /raw_materials/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateCompanyDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /tables/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateCompanyDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      match /batches/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateCompanyDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      // المرتجعات — مالية: الإنشاء لأي فرد، التعديل/الحذف للأدمن
      match /returns/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateFinancialDoc();
        allow delete: if canDeleteCompanyDoc();
      }

      // المستخلصات — مالية زي الفواتير
      match /certificates/{docId} {
        allow get:    if canAccessCompanyDoc();
        allow list:   if canAccessCompanyDoc();
        allow create: if canCreateForCompany();
        allow update: if canUpdateFinancialDoc();
        allow delete: if canDeleteCompanyDoc();
      }

    // المعاينات العقارية
    match /viewings/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canUpdateCompanyDoc();
      allow delete: if canDeleteCompanyDoc();
    }

    // الاشتراكات المتكررة
    match /subscriptions/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canUpdateCompanyDoc();
      allow delete: if canDeleteCompanyDoc();
    }

    // تذاكر الدعم
    match /tickets/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canUpdateCompanyDoc();
      allow delete: if canDeleteCompanyDoc();
    }

    // التحاليل والأشعة والسونار (الملف الطبي)
    match /medical_attachments/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canUpdateCompanyDoc();
      allow delete: if canDeleteCompanyDoc();
    }

    // تقفيل الورديات — الإنشاء والتقفيل لأي فرد (الكاشير بيقفل ورديته)، التعديل للأدمن بس
    // 🔴 إصلاح: كان update مسموح لكل فرد في الشركة (canUpdateCompanyDoc) رغم إن
    // الحقول دي (countedCash / expectedCash / difference) هي تسوية كاش مقفولة.
    // أي كاشير كان يقدر يعمل updateDoc على أي وردية ويكتب difference = 0.
    // ⚠️ ملاحظة: مش بنعمل isAdmin() بس — لأن الكاشير نفسه هو اللي بيقفل
    // ورديته (POS.js / StorePOS.jsx). الحل: العضو يقدر يقفل وردية مفتوحة
    // هو اللي فتحها بس، ولما تقفل بتتقفل للأبد (الوردية المغلقة مش بتتعدل خالص).
    match /closings/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if fullyActive() && canUpdateCompanyDoc() && (
        isAdmin() ||
        (
          resource.data.status == 'open' &&
          request.resource.data.status == 'closed' &&
          (resource.data.openedBy == request.auth.uid ||
           resource.data.createdBy == request.auth.uid)
        )
      );
      allow delete: if canDeleteCompanyDoc();
    }

    // الحضور والانصراف — تسجيل لأي فرد، التعديل لصاحب السجل أو الأدمن، الحذف للأدمن
    //
    // 🔴 إصلاح: كان update مسموح لـ canUpdateCompanyDoc() = **أي فرد في
    // الشركة يعدّل أي سجل حضور لأي حد** (وغيّر checkOut بتاع زميله أو
    // عدّل ساعات شغله). كمان السجلات مربوطة بـ employeeName (نص حر)
    // مش بـ uid، فالتطابق كان هش.
    //
    // الحل: التعديل بسجل **أنت** سجّلته (createdBy) أو للأدمن.
    // (الكود بقى يخزّن employeeId = uid مع الاسم — انظر Attendance.js)
    match /attendance/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if fullyActive() && canUpdateCompanyDoc() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid
      );
      allow delete: if canDeleteCompanyDoc();
    }

      // ============================================================
      // auditLogs/{docId}
      // ============================================================
      match /auditLogs/{docId} {
        allow get:    if fullyActive() && isAdmin() && canAccessCompanyDoc();
        // 🔴 إصلاح: list مقفول على السوبر أدمن — نفس سبب users list.
        // ما كانش فيه أي صفحة بتقرا auditLogs أصلاً، فمفيش فقد وظيفي.
        allow list:   if fullyActive() && isSuperAdmin();
        // ✅ إصلاح نهائي: الشكل الحقيقي 100% من utils/auditLogger.js
        //    - performedBy.uid بيتحقق منه مباشرة (أقوى من مقارنة الإيميل)
        //    - createdAt هو Timestamp حقيقي (new Date() بيتحول تلقائي) فبنتأكد إنه قريب من وقت السيرفر
        //      (نافذة ٥ دقايق) عشان نمنع تلاعب بتواريخ قديمة/مستقبلية في السجل
        allow create: if canCreateForCompany() &&
          request.resource.data.keys().hasOnly(
            ['actionType', 'collectionName', 'itemId', 'details', 'performedBy', 'companyId', 'timestamp', 'createdAt']
          ) &&
          request.resource.data.performedBy.uid == request.auth.uid &&
          request.resource.data.performedBy.role == getUserData().role &&
          request.resource.data.createdAt > request.time - duration.value(5, 'm') &&
          request.resource.data.createdAt < request.time + duration.value(5, 'm');
      }

    // ============================================================
    // profitCoverage/{companyId} — إعداد الكفر في صفحة الأرباح (مستند واحد لكل شركة)
    // ============================================================
    match /profitCoverage/{companyId} {
      allow get: if fullyActive() &&
        (isSuperAdmin() || userCompanyId() == companyId);
      allow list: if fullyActive() && isSuperAdmin();
      allow create, update: if fullyActive() && isAdmin() &&
        (isSuperAdmin() || userCompanyId() == companyId) &&
        request.resource.data.keys().hasOnly(['companyId', 'amount', 'enabled', 'updatedAt', 'updatedBy']);
      allow delete: if fullyActive() && isSuperAdmin();
    }

    // ============================================================
    // fcm_tokens/{userId}
    // ============================================================
      match /fcm_tokens/{userId} {
        allow get:    if requestingUserIsActive() && isLoggedIn() && request.auth.uid == userId;
        allow create: if requestingUserIsActive() && isLoggedIn() && request.auth.uid == userId;
        allow update: if requestingUserIsActive() && isLoggedIn() && request.auth.uid == userId;
        allow delete: if requestingUserIsActive() && isLoggedIn() && request.auth.uid == userId;
        allow list:   if fullyActive() && isSuperAdmin();
      }

    }
  }
