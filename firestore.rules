rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper functions
    // ============================================================

    function isLoggedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'super_admin';
    }

    function isAdmin() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserData().role == 'admin' || getUserData().role == 'super_admin');
    }

    function userCompanyId() {
      return isLoggedIn() ? getUserData().companyId : null;
    }

    // إنشاء مستند — يخص شركة المستخدم، أو السوبر أدمن
    function canCreateForCompany() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (isSuperAdmin() ||
         (request.resource.data.companyId == userCompanyId() && userCompanyId() != null));
    }

    // قراءة / تعديل / حذف مستند واحد — يخص شركة المستخدم فقط، أو السوبر أدمن
    function canAccessCompanyDoc() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (isSuperAdmin() || resource.data.companyId == userCompanyId());
    }

    // ============================================================
    // users/{userId}
    // ============================================================
    match /users/{userId} {
      // المستخدم يقرأ نفسه بس — السوبر أدمن يقرأ الكل
      allow get: if isLoggedIn() && (request.auth.uid == userId || isSuperAdmin());

      // ✅ list: السوبر أدمن يشوف الكل، المستخدم العادي يشوف مستخدمي شركته
      // الـ query لازم يكون مفلتر بـ companyId من ناحية الكود
      allow list: if isSuperAdmin() || (
        isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userCompanyId() != null
      );

      // المستخدم يعمل مستنده بس عند التسجيل، وممنوع يرفع نفسه سوبر أدمن
      allow create: if isLoggedIn() && request.auth.uid == userId &&
        (!("isSuperAdmin" in request.resource.data) ||
         request.resource.data.isSuperAdmin == false);

      // السوبر أدمن يعدل أي حقل — المستخدم العادي يعدل نفسه بدون تغيير الـ role
      allow update: if isLoggedIn() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          (
            (request.resource.data.companyId == resource.data.companyId) ||
            (resource.data.companyId == null && request.resource.data.companyId != null)
          )
        )
      );

      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // companies/{companyId}
    // ============================================================
    match /companies/{companyId} {
      // ✅ get مفتوح لكل المسجلين (لازم عشان كود الانضمام يشتغل)
      allow get: if isLoggedIn();

      // ✅ list: السوبر أدمن يشوف الكل — المستخدم العادي يشوف شركته بس
      allow list: if isSuperAdmin() || (
        isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userCompanyId() != null
      );

      // إنشاء شركة — أي مستخدم مسجل
      allow create: if isLoggedIn();

      // التعديل: السوبر أدمن أو صاحب الشركة بس
      allow update: if isSuperAdmin() || (
        isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().companyId == companyId
      );

      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // بيانات الشركة — عزل كامل حسب companyId
    // ============================================================

    match /clients/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    match /sellers/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    match /buyers/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    match /invoices/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    match /quotations/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    match /purchases/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    match /expenses/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    match /inventory/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    match /tasks/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    match /projects/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    match /suppliers/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    match /messages/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    // ============================================================
    // عيادة / طبيب
    // ============================================================

    match /patients/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    match /appointments/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    match /prescriptions/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    // ============================================================
    // مطعم - أقسام المنيو والخامات
    // ============================================================

    match /menu_categories/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    match /raw_materials/{docId} {
      allow get:    if canAccessCompanyDoc();
      allow list:   if canAccessCompanyDoc();
      allow create: if canCreateForCompany();
      allow update: if canAccessCompanyDoc();
      allow delete: if canAccessCompanyDoc();
    }

    // ============================================================
    // auditLogs/{docId} — سجل العمليات (للأدمن فقط)
    // ============================================================
    match /auditLogs/{docId} {
      // القراءة للأدمن والسوبر أدمن فقط
      allow get:    if isAdmin() && canAccessCompanyDoc();
      allow list:   if isAdmin() && canAccessCompanyDoc();
      // الكتابة: أي مستخدم في الشركة (عشان الـ app يسجل العمليات)
      allow create: if canCreateForCompany();
      // لا يوجد تعديل أو حذف — السجلات تفضل زي ما هي
    }

    // ============================================================
    // fcm_tokens/{userId} — توكنات الإشعارات
    // ============================================================
    match /fcm_tokens/{userId} {
      allow get:    if isLoggedIn() && request.auth.uid == userId;
      allow create: if isLoggedIn() && request.auth.uid == userId;
      allow update: if isLoggedIn() && request.auth.uid == userId;
      allow delete: if isLoggedIn() && request.auth.uid == userId;
      allow list:   if isSuperAdmin();
    }

  }
}
