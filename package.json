{
  "name": "saas-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "firebase": "^12.17.1",
    "jsbarcode": "^3.12.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "emulators": "firebase emulators:start --only firestore,auth,storage",
    "verify:icons": "node tools/verify-icons.mjs",
    "verify:scopes": "node tools/verify-scopes.mjs",
    "verify:encoding": "node tools/verify-encoding.mjs",
    "test:receipt": "node tools/test-receipt.mjs",
    "verify:i18n": "node tools/verify-i18n.mjs",
    "verify:all": "npm run verify:imports && npm run verify:icons && npm run verify:scopes && npm run verify:encoding && npm run verify:i18n && npm run verify:no-placeholder && npm run verify:locale && npm run verify:fmt-calls && npm run verify:rtl && npm run verify:a11y && npm run verify:print && npm run verify:rules && npm run verify:coverage && npm run verify:aging && npm run test:receipt && npm run test:labels && npm run test:limits && npm run test:fmt && npm run test:pdf",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:storage": "firebase deploy --only storage",
     "test:labels": "node tools/test-labels.mjs",
    "verify:no-placeholder": "node tools/verify-no-image-placeholder.mjs",
    "test:limits": "node tools/test-limits.mjs",
    "verify:rules": "node tools/verify-rules.mjs",
    "verify:coverage": "node tools/verify-coverage-scope.mjs",
    "verify:aging": "node tools/verify-aging.mjs",
    "verify:locale": "node tools/verify-locale.mjs",
    "test:fmt": "node tools/test-fmt.mjs",
    "verify:rtl": "node tools/verify-rtl.mjs",
    "verify:a11y": "node tools/verify-a11y.mjs",
    "verify:fmt-calls": "node tools/verify-fmt-calls.mjs",
    "test:pdf": "node tools/test-pdf.mjs",
    "verify:imports": "node tools/verify-imports.mjs",
    "verify:print": "node tools/verify-print.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  }
}
